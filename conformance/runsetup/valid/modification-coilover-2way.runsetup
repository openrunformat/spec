{
  "orf": "1.3",
  "kind": "modification",
  "id": "mod-coilover-2way",
  "version": 1,
  "appliesTo": [],
  "name": { "en": "Coilovers, 2-way dampers", "es": "Roscado, amortiguadores de 2 vías" },
  "operations": [
    { "op": "remove", "key": "x-suspension" },
    { "op": "add", "key": "ride_height" },
