{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/openrunformat/spec/main/schema/runmeta.schema.json",
  "title": "Open Run Format companion file (.runmeta)",
  "description": "The instants s, e, t and splits are absolute Unix epoch nanoseconds; time in userSegments is a duration in nanoseconds. Unknown fields are allowed.",
  "type": "object",
  "required": ["orf", "id", "runlogSha256"],
  "properties": {
    "orf": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "minLength": 1 },
    "runlogSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "vehicle": { "type": "object", "additionalProperties": { "type": "string" } },
    "setup": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["s", "e"],
        "properties": {
          "s": { "type": "integer" },
          "e": { "type": "integer" },
          "values": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      }
    },
    "parameters": {
      "description": "Descriptions of setup parameters outside the standard vocabulary, by base key. A malformed entry is ignored by readers.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/description" }
    },
    "drivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["s", "e", "id", "name"],
        "properties": {
          "s": { "type": "integer" },
          "e": { "type": "integer" },
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "initials": { "type": "string" }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t", "text"],
        "properties": { "t": { "type": "integer" }, "text": { "type": "string" } }
      }
    },
    "userSegments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "s", "e", "src"],
        "properties": {
          "kind": { "type": "string" },
          "s": { "type": "integer" },
          "e": { "type": "integer" },
          "time": { "type": "integer" },
          "tol": { "type": "number" },
          "splits": { "type": "array", "items": { "type": "integer" } },
          "src": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "description": {
      "description": "A description of a setup parameter. A choice needs at least one option; precision only applies to a decimal.",
      "type": "object",
      "required": ["name", "type", "scope"],
      "properties": {
        "name": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
        "type": { "enum": ["text", "bool", "choice", "integer", "decimal"] },
        "scope": { "enum": ["single", "axle", "wheel"] },
        "unit": { "type": "string" },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }
            }
          }
        },
        "allowOther": { "type": "boolean" },
        "catalogKind": { "type": "string" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "precision": { "type": "integer", "minimum": 0 },
        "group": { "type": "string" },
        "personal": { "type": "boolean" },
        "positions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "clickReference": { "enum": ["from_hard", "from_soft"] }
      },
      "allOf": [
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "choice" } } },
          "then": { "required": ["choices"], "properties": { "choices": { "minItems": 1 } } }
        },
        {
          "if": { "required": ["precision"] },
          "then": { "properties": { "type": { "const": "decimal" } } }
        }
      ]
    }
  }
}
